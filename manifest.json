{
  "manifest_version": 3,
  "name": "AIScribe (Offline Writing and Translation Assistant)",
  "description": "A powerful, privacy-focused offline AI writing and translation assistant for Chrome, built for the Chrome Built-in AI Challenge.",
  "version": "0.1.0",
  "action": {
    "default_title": "AIScribe",
    "default_icon": {
      "16": "icons/aiscribe-16.png",
      "32": "icons/aiscribe-32.png",
      "48": "icons/aiscribe-48.png",
      "128": "icons/aiscribe-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/aiscribe-16.png",
    "32": "icons/aiscribe-32.png",
    "48": "icons/aiscribe-48.png",
    "128": "icons/aiscribe-128.png"
  },
  "permissions": ["storage", "activeTab", "contextMenus", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}